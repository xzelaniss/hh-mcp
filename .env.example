# hh-mcp configuration — copy to .env.local and fill in as needed.
# Stdio can use public hh.ru endpoints without configuration.
# HTTP mode always requires authentication, independently of hh.ru credentials.

# OAuth 2.0 Bearer token for hh.ru. Required ONLY for resume endpoints
# (search_resumes / get_resume), which additionally need an employer account
# with a paid resume-database subscription. Get one at https://dev.hh.ru/admin
HH_ACCESS_TOKEN=

# hh.ru REQUIRES an HH-User-Agent header and recommends a contact address.
# Override the default with your own app name + contact email.
# Example: my-job-bot/1.0 (me@example.com)
HH_USER_AGENT=

# --- HTTP mode (only when started with --http or HTTP_PORT set) ---

# Default: bearer. Set oauth for ChatGPT; never use an anonymous mode.
MCP_AUTH_MODE=bearer

# Required only for bearer mode. Generate privately with: openssl rand -hex 32
# Clients send Authorization: Bearer <MCP_SECRET_TOKEN> over HTTPS.
# Never use HH_ACCESS_TOKEN here or put this secret in a URL.
MCP_SECRET_TOKEN=

# Port for HTTP mode (default: 3000). PORT is also honored.
HTTP_PORT=3000

# Interface to bind in HTTP mode (default: 127.0.0.1). Set to 0.0.0.0 to expose.
HOST=127.0.0.1

# DNS-rebinding protection allow-lists for HTTP mode. Comma-separated.
# Defaults to 127.0.0.1:<port>,localhost:<port>. If you bind to a public host,
# add it here or legitimate requests get a 403.
HH_ALLOWED_HOSTS=
HH_ALLOWED_ORIGINS=

# --- ChatGPT OAuth mode (see docs/chatgpt-render.md) ---
# Set MCP_AUTH_MODE=oauth and fill every setting below before HTTP startup.
# Public HTTPS origin WITHOUT /mcp, e.g. https://your-service.onrender.com
MCP_PUBLIC_URL=
# Exact Auth0 issuer WITH trailing slash, e.g. https://your-tenant.auth0.com/
MCP_OAUTH_ISSUER=
# Client ID, not Client Secret. Keep the OAuth Client Secret only in ChatGPT.
MCP_OAUTH_CLIENT_ID=
# Your exact Auth0 User ID (sub), comma-separated if multiple owners.
MCP_OAUTH_ALLOWED_SUBJECTS=
